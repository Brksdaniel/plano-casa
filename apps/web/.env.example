# DENIELS HOME TRACKER — copie para .env.local e preencha.
# Variáveis NEXT_PUBLIC_* vão para o navegador: nunca coloque segredos nelas.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Endereço público do site (em produção, o domínio da Vercel). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Somente servidor (Etapas seguintes). NUNCA use prefixo NEXT_PUBLIC_ aqui. ---
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...) — Etapa 3
SUPABASE_SECRET_KEY=
# Segredo aleatório que protege /api/cron/monitor (gere com: openssl rand -hex 32) — Etapa 3
CRON_SECRET=
# Resend → API Keys — Etapa 7
RESEND_API_KEY=
# Remetente dos e-mails (ex.: "Deniels Home Tracker <onboarding@resend.dev>") — Etapa 7
NOTIFY_FROM_EMAIL=
# ID da extensão do Chrome (chrome://extensions) — Etapa 4
EXTENSION_ID=

# ID da extensão do Chrome (gerado por apps/extension/scripts/make-key.mjs) — público
NEXT_PUBLIC_EXTENSION_ID=
